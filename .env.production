# Canonical site origin, substituted into index.html (%VITE_SITE_URL%) at build
# and read by SEO.jsx at runtime. No trailing slash.
# www is the primary domain in Vercel (the bare domain 308-redirects to it),
# so canonical/OG/JSON-LD URLs use www to match.
VITE_SITE_URL=https://www.faithchurchleslie.com
